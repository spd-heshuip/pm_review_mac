{
  "productName": "Lespark需求审查",
  "version": "0.1.0",
  "identifier": "com.lespark.pm-review",
  "build": {
    "frontendDist": "../dist-ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:bridge && node scripts/stage-runtime.mjs && npm run build:ui"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "resources": {
      "../bundle-resources/package.json": "package.json",
      "../bundle-resources/dist/": "dist/",
      "../bundle-resources/node_modules/": "node_modules/",
      "../bundle-resources/node/": "node/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
